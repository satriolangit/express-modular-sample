# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Postgres
PG_HOST=8.215.75.12
PG_PORT=5439
PG_USER=postgres
PG_PASSWORD=cx123456.
PG_DATABASE=arsi_system_db
PG_POOL_MAX=20

# NATS
NATS_SERVERS=nats://localhost:4222
NATS_NAME=base-api
NATS_JETSTREAM=true
NATS_REQUIRED=false
NATS_MAX_RECONNECT=5           # -1 = infinite
NATS_RECONNECT_WAIT_MS=2000
NATS_AUTO_RETRY_AFTER_EXHAUST=true      # true = coba lagi tiap X ms
NATS_RETRY_AFTER_EXHAUST_MS=30000

# WebSocket
WS_HEARTBEAT_MS=30000
WS_MAX_PAYLOAD=1048576

# Misc
API_KEY=poc-secret-key