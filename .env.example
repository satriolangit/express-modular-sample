# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=false

# PostgreSQL — required
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DATABASE=arsi_system_db
PG_POOL_MAX=20

# NATS — optional (degraded mode when unavailable)
NATS_SERVERS=nats://localhost:4222
NATS_NAME=base-api
NATS_JETSTREAM=true
NATS_REQUIRED=false
NATS_MAX_RECONNECT=5
NATS_RECONNECT_WAIT_MS=2000
NATS_AUTO_RETRY_AFTER_EXHAUST=true
NATS_RETRY_AFTER_EXHAUST_MS=30000

# WebSocket
WS_HEARTBEAT_MS=30000
WS_MAX_PAYLOAD=1048576

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TZ=UTC

# Misc
API_KEY=change-me
